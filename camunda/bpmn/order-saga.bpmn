        <di:waypoint x="1160" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Shipment_Capture_di" bpmnElement="Flow_Shipment_Capture">
        <di:waypoint x="1260" y="280" />
        <di:waypoint x="1320" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Capture_End_di" bpmnElement="Flow_Capture_End">
        <di:waypoint x="1420" y="280" />
        <di:waypoint x="1480" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Err_Task_Inventory_di" bpmnElement="Flow_Err_Task_Inventory">
        <di:waypoint x="320" y="338" />
        <di:waypoint x="320" y="580" />
        <di:waypoint x="1450" y="580" />
      </bpmndi:BPMNEdge>
